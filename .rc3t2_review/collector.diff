+    def _publish_acquisition_diagnostics(self, cycle_id):
+        """Publish one scalar summary of captured records; never access sources.
+
+        CollectionCycleTrace remains authoritative for global cycle failures.
+        Older observations keep their original IDs so the pure consolidator
+        can reject their association. Any publication failure clears the slot
+        without replacing the market return or the original exception.
+        """
+        self.last_acquisition_diagnostics = None
+        self.last_acquisition_diagnostics_error = None
+        try:
+            trace = self.last_collection_cycle
+            if (type(cycle_id) is not int or cycle_id <= 0
+                    or type(trace) is not CollectionCycleTrace
+                    or type(trace.cycle_id) is not int or trace.cycle_id != cycle_id):
+                self.last_acquisition_diagnostics_error = "ACQUISITION_DIAGNOSTICS_TRACE_UNAVAILABLE"
+                return
+            samples = tuple(SampleRecord(s.cycle_id, s.sample_position, s.state,
+                                         s.reader_metadata, s.reason)
+                            for s in trace.acquisition_metadata)
+            snapshot = self.last_snapshot_observation
+            snapshot_record = (None if snapshot is None else SnapshotRecord(
+                snapshot.cycle_id, trace.observation_relation,
+                snapshot.diagnostic, snapshot.error))
+            temporal = self.last_temporal_observation
+            temporal_record = (None if temporal is None else TemporalRecord(
+                temporal.cycle_id, temporal.sample_position,
+                temporal.diagnostic, temporal.error))
+            diagnostic = summarize_acquisition_diagnostics(
+                cycle_id, samples=samples, snapshot=snapshot_record, temporal=temporal_record)
+            if (type(diagnostic) is not AcquisitionDiagnostics
+                    or type(diagnostic.cycle_id) is not int or diagnostic.cycle_id != cycle_id
+                    or any(flag is not False for flag in (diagnostic.orders_allowed,
+                           diagnostic.live_certified, diagnostic.flow_complete))):
+                raise TypeError("UNSUPPORTED_ACQUISITION_DIAGNOSTICS")
+            self.last_acquisition_diagnostics = diagnostic
+        except Exception:
+            self.last_acquisition_diagnostics = None
+            self.last_acquisition_diagnostics_error = "ACQUISITION_DIAGNOSTICS_PUBLICATION_FAILED"
 
